{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "default_locale": "vi",
  "version": "1.0.7",
  "description": "__MSG_appDesc__",
  "homepage_url": "https://tree55.com",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.threads.net/*",
    "https://*.threads.com/*",
    "https://*.tree55.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*"
      ],
      "js": [
        "src/main/inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*"
      ],
      "js": [
        "src/common/i18n.js",
        "src/common/protocol.js",
        "src/content/bridge.js",
        "src/content/identity.js",
        "src/content/dom-blocker.js",
        "src/content/report-ui.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/blocker.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "_locales/*/messages.json"
      ],
      "matches": [
        "https://*.facebook.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*"
      ]
    }
  ]
}
