node_modules/
.playwright-mcp/
server/blocklist.json
*.log
server/reports.json

# Never commit local secrets (admin/submit tokens, API keys).
.env
.env.*

# Per-server HMAC salt for reporter pseudonyms. Losing it resets every
# reporter to a stranger; leaking it de-anonymises the report store.
server/.reporter-salt

# The popup capture prints the signed-in account id in its capability
# panel. It is written to a temp dir by tools/make-store-assets.js and must
# never be committed.
docs/shots/popup.png

ui-debug.log

# Generated by tools/publish-static.js from blocklist/current; never authored.
hosting/blocklist.json

# The same, from blocklist/publicView: the transparency page's data, mirrored
# to the CDN so a visitor costs no database read. Regenerated on every deploy.
hosting/transparency.json

# Release artefacts from tools/pack.js. Rebuildable from any commit, and a
# stale zip in the tree is a zip somebody eventually uploads by mistake.
dist/

# emulators need. Production must never serve those, which is the whole point
# of generating it instead of committing one config with both.

# The CRX signing key (tools/make-crx.js). The extension id IS this key:
# it lives in the CRX_PRIVATE_KEY repository secret and a backup, never here.
*.pem

# The backend keeps its dependencies, its database and its published
# artifacts out of the repository.
server/node_modules/
server/data/
server/public/
deploy/api.env

# ...but the example IS committed: it is the only place the required keys
# are written down, and a list of secrets nobody can find is not security.
!.env.example
